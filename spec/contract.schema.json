{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:piepowder:schema:contract:0.1",
  "title": "Piepowder contract authoring schema (0.1)",
  "description": "Typed two-party geocode obligations. Missing or null acceptance, assessor, trigger, deadline and mandate references remain authorable so the runtime can report structural lint findings; unspecified denominator is deliberately representable. Unsupported assessor or acceptance kinds are outside this authoring schema even though the runtime can report them for review.",
  "$comment": "Offline authoring aid only. Runtime also enforces lexical integers, bounded UTF-8 JSON, exact artifacts, cross-references, time relations and safe local file access.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "piepowder.contract/0.1"
    },
    "contract_id": {
      "$ref": "#/$defs/identifier"
    },
    "parties": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "party_id": {
            "$ref": "#/$defs/identifier"
          },
          "role": {
            "enum": [
              "buyer",
              "seller"
            ]
          },
          "principal_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "agent_id": {
            "$ref": "#/$defs/identifier"
          }
        },
        "required": [
          "party_id",
          "role",
          "principal_name",
          "agent_id"
        ]
      }
    },
    "formed_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3,
      "pattern": "^[A-Z]{3}$"
    },
    "price_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        }
      },
      "required": [
        "policy_id",
        "version"
      ]
    },
    "mandate_ids": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "const": []
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      ]
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "obligation_id": {
            "$ref": "#/$defs/identifier"
          },
          "debtor": {
            "$ref": "#/$defs/identifier"
          },
          "creditor": {
            "$ref": "#/$defs/identifier"
          },
          "trigger_at": {
            "anyOf": [
              {
                "$ref": "#/$defs/utcTimestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "due_at": {
            "anyOf": [
              {
                "$ref": "#/$defs/utcTimestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "acceptance": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "geocode_accuracy"
                  },
                  "evidence_id": {
                    "$ref": "#/$defs/identifier"
                  },
                  "assessor_id": {
                    "anyOf": [
                      {
                        "const": "offline-deterministic"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sample_size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "threshold_bps": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "denominator": {
                    "enum": [
                      "unspecified",
                      "all_sampled",
                      "exclude_flagged"
                    ]
                  },
                  "max_flagged_bps": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  }
                },
                "required": [
                  "kind",
                  "evidence_id",
                  "sample_size",
                  "threshold_bps",
                  "denominator",
                  "max_flagged_bps"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "obligation_id",
          "debtor",
          "creditor"
        ]
      }
    },
    "prose": {
      "type": "string",
      "maxLength": 8192
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "parties",
    "formed_at",
    "currency",
    "price_minor",
    "policy",
    "obligations"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "utcTimestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    }
  }
}
