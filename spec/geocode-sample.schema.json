{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:piepowder:schema:geocode-sample:0.1",
  "title": "Piepowder geocode-sample authoring schema (0.1)",
  "description": "Fictional or recorded count assertions. Runtime requires the three outcome counts to sum to sample_size and match the contractual sample size. Neither this schema nor the engine establishes sample selection, reference-service accuracy or factual truth.",
  "$comment": "Offline authoring aid only. Runtime also enforces lexical integers, bounded UTF-8 JSON, exact artifacts, cross-references, time relations and safe local file access.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "piepowder.geocode-sample/0.1"
    },
    "sample_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "correct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "incorrect": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "flagged_unresolvable": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "required": [
    "schema_version",
    "sample_size",
    "correct",
    "incorrect",
    "flagged_unresolvable"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "utcTimestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    }
  }
}
