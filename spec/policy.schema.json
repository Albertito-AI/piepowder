{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:piepowder:schema:policy:0.1",
  "title": "Piepowder policy authoring schema (0.1)",
  "description": "The only supported offline policy creates no automatic legal effects, no default acceptance and no automatic timeout disposition. Exact policy identity/version must match the contract at runtime.",
  "$comment": "Offline authoring aid only. Runtime also enforces lexical integers, bounded UTF-8 JSON, exact artifacts, cross-references, time relations and safe local file access.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "piepowder.policy/0.1"
    },
    "policy_id": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S"
    },
    "automatic_legal_effects": {
      "const": false
    },
    "default_acceptance": {
      "const": "none"
    },
    "timeout_consequence": {
      "const": "human_review"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "automatic_legal_effects",
    "default_acceptance",
    "timeout_consequence"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "utcTimestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    }
  }
}
