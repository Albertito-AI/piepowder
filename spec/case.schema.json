{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:piepowder:schema:case:0.1",
  "title": "Piepowder case authoring schema (0.1)",
  "description": "Case labels and explicit contested-record references; the runtime verifies that referenced identifiers exist.",
  "$comment": "Offline authoring aid only. Runtime also enforces lexical integers, bounded UTF-8 JSON, exact artifacts, cross-references, time relations and safe local file access.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "piepowder.case/0.1"
    },
    "case_id": {
      "$ref": "#/$defs/identifier"
    },
    "contested_evidence_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "contested_obligation_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "contested_evidence_ids",
    "contested_obligation_ids"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "utcTimestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    }
  }
}
