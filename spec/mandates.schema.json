{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:piepowder:schema:mandates:0.1",
  "title": "Piepowder mandates authoring schema (0.1)",
  "description": "Recorded authority claims. The runtime compares formation scope only, and cannot verify identity, signatures, true authority or later event delegation. An empty list is valid data and produces an unresolved mandate finding.",
  "$comment": "Offline authoring aid only. Runtime also enforces lexical integers, bounded UTF-8 JSON, exact artifacts, cross-references, time relations and safe local file access.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "piepowder.mandates/0.1"
    },
    "mandates": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mandate_id": {
            "$ref": "#/$defs/identifier"
          },
          "principal_party_id": {
            "$ref": "#/$defs/identifier"
          },
          "agent_id": {
            "$ref": "#/$defs/identifier"
          },
          "valid_from": {
            "$ref": "#/$defs/utcTimestamp"
          },
          "valid_until": {
            "$ref": "#/$defs/utcTimestamp"
          },
          "revoked_at": {
            "anyOf": [
              {
                "$ref": "#/$defs/utcTimestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "pattern": "^[A-Z]{3}$"
          },
          "maximum_price_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "allowed_counterparties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "allowed_actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "form_contract",
                "deliver",
                "submit_evidence",
                "file_dispute"
              ]
            }
          },
          "authority_basis": {
            "const": "recorded_claim"
          }
        },
        "required": [
          "mandate_id",
          "principal_party_id",
          "agent_id",
          "valid_from",
          "valid_until",
          "revoked_at",
          "currency",
          "maximum_price_minor",
          "allowed_counterparties",
          "allowed_actions",
          "authority_basis"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "mandates"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "utcTimestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    }
  }
}
