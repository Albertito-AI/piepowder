{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:piepowder:schema:evidence:0.1",
  "title": "Piepowder evidence authoring schema (0.1)",
  "description": "A local evidence manifest. A SHA-256 commitment is not proof of identity, truth or timing. The runtime checks identifier/path uniqueness, hash matches, party/duty/case references, file budgets and containment. An empty list is valid data and cannot satisfy an absent acceptance sample.",
  "$comment": "Offline authoring aid only. Runtime also enforces lexical integers, bounded UTF-8 JSON, exact artifacts, cross-references, time relations and safe local file access.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "piepowder.evidence/0.1"
    },
    "case_id": {
      "$ref": "#/$defs/identifier"
    },
    "items": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "$ref": "#/$defs/identifier"
          },
          "obligation_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/identifier"
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200,
            "pattern": "^evidence/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$",
            "not": {
              "anyOf": [
                {
                  "pattern": "\\s"
                },
                {
                  "pattern": "(?:^|/)\\.\\.?(?:/|$)"
                },
                {
                  "pattern": "\\.(?:/|$)"
                }
              ]
            },
            "description": "Portable relative path under evidence/. Runtime additionally rejects reserved names, aliases, links, reparse points, unsafe opened files and paths outside the case root."
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "geocode_sample",
              "quoted_text"
            ]
          },
          "submitted_by": {
            "$ref": "#/$defs/identifier"
          },
          "recorded_at": {
            "$ref": "#/$defs/utcTimestamp"
          }
        },
        "required": [
          "evidence_id",
          "obligation_id",
          "path",
          "sha256",
          "kind",
          "submitted_by",
          "recorded_at"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "geocode_sample"
                }
              }
            },
            "then": {
              "properties": {
                "obligation_id": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "items"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "utcTimestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    }
  }
}
